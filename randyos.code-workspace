	],
	"settings": {
		"files.exclude": {
			"**/node_modules/**": true,
			"**/.zig-cache/**": true,
			"**/zig-pkg/**": true,
			"**/zig-cache*/**": true,
		},
		"files.watcherExclude": {
			"**/node_modules/**": true,
			"**/.zig-cache/**": true,
			"**/zig-pkg/**": true,
			"**/zig-cache*/**": true,
		},
    "files.associations": {
      "VERSION": "plaintext",
      ".local-gitignore": "gitignore",
      ".github/workflows/exempt.txt": "gitignore"
    },
    "terminal.integrated.automationProfile.windows": {
      "path": "C:\\windows\\system32\\cmd.exe",
    },
    "ltex.additionalRules.motherTongue": "en-US",
    "zig.zls.enabled": "on",
    "zig.zls.inlayHintsShowParameterName": false,
    "zig.zls.inlayHintsExcludeSingleArgument": false,
    "zig.zls.inlayHintsShowBuiltin": false,
    "zig.zls.inlayHintsShowStructLiteralFieldType": false,
    "zig.zls.inlayHintsShowVariableTypeHints": false,
    "zig.zls.warnStyle": true,
	  "debug.onTaskErrors": "abort",  // will switch to problems pane otherwise

    // for C deps we will compile with Zig that have CMakeLists in their repos
